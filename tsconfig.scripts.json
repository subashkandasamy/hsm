{
  // The app's tsconfig excludes scripts/ so a production build never type-checks
  // local tooling — that is what broke the Vercel build, because playwright-core
  // is a developer dependency the deployed app has no reason to resolve.
  //
  // The scripts still deserve checking, just not there:  npm run typecheck:scripts
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts"],
  "exclude": ["node_modules"]
}
