# Copy to e2e/.env.e2e (git-ignored) or run "npm run e2e:accounts" to fill it.
# The suite refuses any hospital that is not a test hospital (never karur).

E2E_BASE_URL=https://demo.uyirly.com
E2E_TENANT_SLUG=demo
E2E_PORTAL_URL=https://my.uyirly.com

# Browser
E2E_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
E2E_HEADLESS=true
# Multiply every fixed wait (2 = twice as patient) on a slow connection
E2E_WAIT_SCALE=1

# Other staff on the test hospital the flows pick from lists
E2E_ANAESTHETIST=Dr. Arun Prakash
E2E_SECOND_NURSE=Sister Anitha John
E2E_PAEDIATRICIAN=Dr. Lakshmi Iyer

# Test staff accounts (one per role). "npm run e2e:accounts" writes these.
E2E_ADMIN_EMAIL=e2e.admin@example.com
E2E_ADMIN_PASSWORD=
E2E_ADMIN_NAME=E2E Admin
E2E_DOCTOR_EMAIL=e2e.doctor@example.com
E2E_DOCTOR_PASSWORD=
E2E_DOCTOR_NAME=Dr. E2E Priya Varman
E2E_NURSE_EMAIL=e2e.nurse@example.com
E2E_NURSE_PASSWORD=
E2E_NURSE_NAME=E2E Sister Kala
E2E_RECEPTIONIST_EMAIL=e2e.receptionist@example.com
E2E_RECEPTIONIST_PASSWORD=
E2E_RECEPTIONIST_NAME=E2E Mani (Front desk)
E2E_LAB_TECH_EMAIL=e2e.labtech@example.com
E2E_LAB_TECH_PASSWORD=
E2E_LAB_TECH_NAME=E2E Arul (Lab)
E2E_PHARMACIST_EMAIL=e2e.pharmacist@example.com
E2E_PHARMACIST_PASSWORD=
E2E_PHARMACIST_NAME=E2E Bala (Pharmacy)
E2E_HR_EMAIL=e2e.hr@example.com
E2E_HR_PASSWORD=
E2E_HR_NAME=E2E Geetha (HR)
E2E_ACCOUNTANT_EMAIL=e2e.accountant@example.com
E2E_ACCOUNTANT_PASSWORD=
E2E_ACCOUNTANT_NAME=E2E Ravi (Accounts)
