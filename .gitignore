# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!/e2e/.env.e2e.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# capacitor
/www

# The connector is a separate program a hospital runs on its own PC.
connector/node_modules/
connector/dist/
connector/dist-exe/
connector/.build/

# Intermediate captures from `npm run shots` — the squeezed .png is the artefact.
public/guides/*.raw.png

# E2E suite: run output (screenshots, PDFs, reports)
/e2e/results/
